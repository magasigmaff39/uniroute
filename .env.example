# ---- Server ----
API_PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# ---- AI providers (server-side only; never shipped to the browser) ----
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Firebase (Google sign-in; Firestore in production) ----
FIREBASE_PROJECT_ID=university-route-741a
# Use Firestore from a laptop: path to a service-account JSON from Firebase Console → Project settings → Service accounts
# FIREBASE_SERVICE_ACCOUNT=./server/data/service-account.json
# DB_DRIVER=firestore
# FILE_STORAGE=firestore

# ---- Frontend (public web config of the Firebase app: Firebase Console → Project settings → Your apps → Web) ----
# Only needed for Google sign-in; e-mail registration and the whole applicant path work without it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=university-route-741a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=university-route-741a
VITE_FIREBASE_APP_ID=1:985488039757:web:a10459f11ce01c7b2be104
# Point the frontend at a remote API (e.g. Vercel) instead of the same origin:
# VITE_API_URL=https://your-api.example.com

# ---- Email (optional) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Registration ----
OTP_REQUIRED=false
OTP_DEV_MODE=true
